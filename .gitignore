# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
frontend/public/vad/
*.tsbuildinfo

# Data & models (large / licensed / potentially sensitive)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Judgment PDFs: provenance + sha256 are tracked in data/manifest.json instead (ADR 0002)
data/family_law_dataset/
# Vector index (rebuild with `python -m scripts.build_index`)
data/index/
# Conversation memory (encrypted SQLite + generated dev key)
data/sessions/
models/*
!models/.gitkeep
reports/*
!reports/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# uv download cache kept on D: (C: is nearly full); see CLAUDE.md
.uv-cache/
.tmp/

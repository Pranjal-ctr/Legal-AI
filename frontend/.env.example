# Copy to frontend/.env (never commit .env).

# Where the Vite dev server proxies /api requests (server-side only, not exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Base URL the browser uses for API calls. Leave unset in dev to use the proxy (/api/v1).
# VITE_API_BASE_URL=https://api.example.org/api/v1

# Copy to .env (never commit .env). All backend settings use the LEGALAI_ prefix.

LEGALAI_APP_NAME="Kanoon AI"
# development | test | production
LEGALAI_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LEGALAI_LOG_LEVEL=INFO
# true = one JSON object per line (use in production); false = human-readable console output
LEGALAI_LOG_JSON=false

LEGALAI_HOST=127.0.0.1
LEGALAI_PORT=8000

# JSON list of browser origins allowed to call the API directly
LEGALAI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

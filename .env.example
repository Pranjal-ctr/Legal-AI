# Copy to .env (never commit .env). All backend settings use the LEGALAI_ prefix.

LEGALAI_APP_NAME="Kanoon AI"
# development | test | production
LEGALAI_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LEGALAI_LOG_LEVEL=INFO
# true = one JSON object per line (use in production); false = human-readable console output
LEGALAI_LOG_JSON=false

LEGALAI_HOST=127.0.0.1
LEGALAI_PORT=8000

# JSON list of browser origins allowed to call the API directly
LEGALAI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Retrieval / generation (Phase 3) ---
# auto | cpu | cuda (use cpu if the GPU is short on memory next to the LLM)
LEGALAI_EMBEDDING_DEVICE=auto
LEGALAI_RETRIEVAL_TOP_K=6
# Unset = embedded Qdrant under data/index/qdrant
# LEGALAI_QDRANT_URL=http://localhost:6333
LEGALAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
LEGALAI_OLLAMA_MODEL=gemma4:e4b

# --- LLM provider (ADR 0012) ---
# ollama (local, default) | gemini (Google Gemini API; questions leave this machine)
LEGALAI_LLM_PROVIDER=ollama
# Required when the provider is gemini. One key covers every model. Never commit it.
# LEGALAI_GEMINI_API_KEY=
# LEGALAI_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional second model for short calls (understanding, evidence check, question translation)
# LEGALAI_GEMINI_LIGHT_MODEL=gemma-4-31b-it
# minimal | low | medium | high (unset = model default)
# LEGALAI_GEMINI_THINKING_LEVEL=minimal
# Per-minute 429s are retried when the server asks for at most this many seconds
# LEGALAI_GEMINI_MAX_RETRY_WAIT_S=20

# --- Hybrid retrieval (Phase 4) ---
# dense | bm25 | hybrid
LEGALAI_RETRIEVAL_MODE=hybrid
LEGALAI_RETRIEVAL_CANDIDATES=30
LEGALAI_RERANK_ENABLED=true
# replace | fuse (fuse = RRF of first stage + reranker; safer for statute clauses)
LEGALAI_RERANK_STRATEGY=fuse
LEGALAI_RERANKER_DEVICE=auto

# --- Agentic orchestrator (Phases 6-7) ---
LEGALAI_AGENT_MAX_ROUNDS=2
LEGALAI_AGENT_ASSESS_EVIDENCE=true
LEGALAI_AGENT_MAX_SOURCES=8
LEGALAI_LLM_TEMPERATURE=0.1
LEGALAI_LLM_NUM_CTX=8192
LEGALAI_LLM_TIMEOUT_S=180

# --- Conversation memory (Phase 8) ---
# Fernet key; REQUIRED in production. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset in development: a key is generated into data/sessions/secret.key
# LEGALAI_SESSION_KEY=
LEGALAI_SESSION_TTL_DAYS=30
LEGALAI_SESSION_HISTORY_TURNS=3

# --- Latency (ADR 0008) ---
LEGALAI_WARMUP_ON_STARTUP=true
LEGALAI_LLM_KEEP_ALIVE=30m

# --- Speech (Phases 9-10; needs `uv sync --extra speech`) ---
LEGALAI_ASR_ENABLED=true
# large-v3-turbo (best hi/kn) | medium | small (faster, less accurate)
LEGALAI_ASR_MODEL=large-v3-turbo
LEGALAI_ASR_DEVICE=cpu
LEGALAI_ASR_MAX_SECONDS=60
LEGALAI_ASR_MAX_UPLOAD_MB=10
LEGALAI_TTS_ENABLED=true
LEGALAI_TTS_MAX_CHARS=1200
# Temp files (audio uploads) - keep them off a full system drive
LEGALAI_TEMP_DIR=.tmp

# --- Abuse protection (Phase 12, docs/security.md) ---
LEGALAI_RATE_LIMIT_ENABLED=true
LEGALAI_RATE_LIMIT_CHAT_PER_MIN=12
LEGALAI_RATE_LIMIT_SPEECH_PER_MIN=40
# Only behind a trusted reverse proxy that sets X-Forwarded-For (else clients can spoof their IP)
LEGALAI_TRUST_PROXY_HEADERS=false
